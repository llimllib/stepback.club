---
import Base from "../layouts/Base.astro"
---

<Base title="Matchup" description="The players a prediction rests on: each team's projected lineup and ratings">
  <span class="kicker">Matchup</span>
  <h1 id="title">&nbsp;</h1>
  <p id="status" class="note matchup-status"></p>
  <div id="matchup" class="matchup"></div>
</Base>

<script>
  import { download, toPng } from "../kit/export"
  import { fontsReady } from "../kit/frame"
  import { loadingText } from "../kit/mount"
  import {
    atBar,
    matchup,
    matchupFrame,
    matchupTable,
    NET_PTS_MIN_POSS,
    teamTable,
    type Matchup,
  } from "../scores/matchup"

  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
  const $ = (id: string) => document.getElementById(id)!
  const [title, status, body] = [$("title"), $("status"), $("matchup")]

  const el = <K extends keyof HTMLElementTagNameMap>(
    tag: K,
    props: Partial<HTMLElementTagNameMap[K]> = {},
    ...children: (Node | string)[]
  ) => {
    const e = Object.assign(document.createElement(tag), props)
    e.append(...children)
    return e
  }
  const day = (d: Date) =>
    d.toLocaleDateString("en-US", {
      timeZone: "America/New_York",
      weekday: "short",
      month: "short",
      day: "numeric",
    })

  // The PNG: the table drawn again as SVG in the kit's frame, off screen,
  // exported like a tool's chart
  async function exportPng(m: Matchup, button: HTMLButtonElement, note: HTMLElement) {
    button.disabled = true
    note.textContent = "Exporting…"
    const holder = el("div", { className: "offscreen" })
    document.body.append(holder)
    try {
      await fontsReady()
      const svg = matchupFrame(holder, m)
      const { blob, missingImages } = await toPng(svg, new URL(base, location.href).href)
      const [a, h] = m.prediction.teams
      const date = m.prediction.start.toLocaleDateString("en-CA", { timeZone: "America/New_York" })
      download(blob, `${a.abbrev}-at-${h.abbrev}-${date}.png`.toLowerCase())
      note.textContent = missingImages
        ? `Exported, but ${missingImages} images couldn't be embedded (no CORS)`
        : ""
    } catch (e) {
      console.error(e)
      note.textContent = "Couldn't export"
    } finally {
      holder.remove()
      button.disabled = false
    }
  }

  async function show() {
    const game = new URLSearchParams(location.search).get("game") ?? ""
    body.innerHTML = loadingText()
    body.dataset.state = "loading"
    let m
    try {
      m = /^\d{10}$/.test(game) ? await matchup(game) : undefined
    } catch (e) {
      console.error(e)
      title.textContent = "Matchup"
      body.replaceChildren()
      status.replaceChildren("Couldn't load the prediction. ")
      body.dataset.state = "failed"
      return
    }
    if (!m) {
      title.textContent = "Matchup"
      body.replaceChildren()
      status.replaceChildren(
        "No prediction for this game: it's been played, or its teams aren't set. ",
        el("a", { href: `${base}scores` }, "Scores →"),
      )
      body.dataset.state = "empty"
      return
    }

    const p = m.prediction
    const [a, h] = p.teams
    const date = p.start.toLocaleDateString("en-CA", {
      timeZone: "America/New_York",
    })
    document.title = `${a.abbrev} at ${h.abbrev} · Matchup · Step Back Club`
    title.textContent = `${a.name} ${p.neutral ? "vs." : "at"} ${h.name}`
    // the game's day and time, each team's chance and expected score, are
    // in the table's head, so the status line is only for failures
    status.replaceChildren()
    const asOf = day(new Date(`${p.asOf}T12:00:00Z`))
    const link = (href: string, text: string) => el("a", { href }, text)
    const epmAsOf = m.epmAsOf ? `, as of ${day(new Date(`${m.epmAsOf}T12:00:00Z`))}` : ""
    body.replaceChildren(
      matchupTable(m),
      // a phone gets one team's table at a time
      el(
        "div",
        { className: "stacked" },
        teamTable(m.lineups[0], "away"),
        atBar(p),
        teamTable(m.lineups[1], "home"),
      ),
      // what the columns mean, set off from the table so its labels don't
      // read as more rows
      el("h2", { className: "kicker key-head" }, "Key"),
      el(
        "dl",
        { className: "key" },
        el("dt", {}, "Min"),
        el("dd", {}, "Expected minutes, counting the chance they don't play"),
        el("dt", {}, "yarapm"),
        el(
          "dd",
          {},
            "Score estimate, win probability, and points per 100 possessions better than an average player by ",
          link("https://github.com/llimllib/yarapm/", "yarapm"),
          `, as of ${asOf}`,
        ),
        el("dt", {}, "EPM"),
        el(
          "dd",
          {},
            "Points per 100 possessions better than an average player by ",
          link("https://dunksandthrees.com/epm", "dunksandthrees"),
          `' predictive EPM${epmAsOf}`,
        ),
        el("dt", {}, "Net pts"),
        el(
          "dd",
          {},
          link("https://espnanalytics.com/", "ESPN Analytics"),
          "' net points per 100 possessions this season. Blank under " +
            `${NET_PTS_MIN_POSS} possessions`,
        ),
        el("dt", {}, "Team"),
        el(
          "dd",
          {},
            "Player ratings weighted by minutes, a blank counts as average",
        ),
      ),
      el("a", { className: "more", href: `${base}scores?date=${date}` }, `← ${day(p.start)}'s games`),
    )
    const note = el("span", { className: "export-note", role: "status" })
    const button = el("button", { type: "button", className: "export" }, "Export PNG")
    button.addEventListener("click", () => exportPng(m, button, note))
    status.after(el("div", { className: "export-row" }, button, note))
    body.dataset.state = "done"
  }
  show()
</script>
