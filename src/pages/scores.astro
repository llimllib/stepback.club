---
import Base from "../layouts/Base.astro"
---

<Base title="Scores" description="Every game of the day, with the four factors and how the winner won, and predictions for the games ahead">
  <span class="kicker">Scores</span>
  <h1 id="day">&nbsp;</h1>
  <div class="days">
    <a id="prev" class="more" hidden>← Prev</a>
    <input id="date" type="date" aria-label="Date" />
    <a id="next" class="more" hidden>Next →</a>
  </div>
  <p id="note" class="note" hidden></p>
  <div id="games" class="games"></div>
</Base>

<script>
  import { loadingText } from "../kit/mount"
  import {
    factorsFor,
    gamesOn,
    lastGameDay,
    latestNight,
    nearestGameDay,
    seasonRange,
    addDays,
    today,
    type Game,
  } from "../scores/load"
  import { loggedFor, predictionsOn } from "../scores/predict"
  import {
    gameBlock,
    predictionBlock,
    setFactors,
    setLogged,
  } from "../scores/render"

  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
  const $ = (id: string) => document.getElementById(id)!
  const [day, input, prev, next, note, grid] = [
    $("day"),
    $("date") as HTMLInputElement,
    $("prev") as HTMLAnchorElement,
    $("next") as HTMLAnchorElement,
    $("note"),
    $("games"),
  ]

  const long = (date: string) =>
    new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", {
      timeZone: "UTC",
      weekday: "long",
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  // the year only when it isn't this one
  const short = (date: string) =>
    new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", {
      timeZone: "UTC",
      weekday: "short",
      month: "short",
      day: "numeric",
      year: date.slice(0, 4) === today().slice(0, 4) ? undefined : "numeric",
    })
  const href = (date: string) => `?date=${date}`
  const valid = (d: string | null) =>
    d && /^\d{4}-\d{2}-\d{2}$/.test(d) && !isNaN(Date.parse(d)) ? d : null

  // ahead as far as there are predictions
  input.max = today()
  lastGameDay().then(
    d => (input.max = d && d > today() ? d : today()),
    () => {},
  )
  seasonRange().then(
    r => (input.min = `${r.first - 1}-10-01`),
    () => {},
  )

  // The newest render wins: a slow read for a date left behind is dropped
  let current = 0

  // Show a date: the one in the URL, or yesterday. Yesterday may not be in
  // yet, so the default falls back to the latest day with games
  async function show() {
    const id = ++current
    const asked = valid(new URLSearchParams(location.search).get("date"))
    const yesterday = addDays(today(), -1)
    let date = asked ?? yesterday
    heading(date)
    note.hidden = true
    grid.innerHTML = loadingText()
    grid.dataset.state = "loading"

    let games: Game[]
    try {
      if (asked) games = await gamesOn(date)
      else {
        const night = await latestNight()
        if (id !== current) return
        ;({ date, games } = night)
        if (date !== yesterday) {
          say(`No games in for ${short(yesterday)} yet; showing ${short(date)}.`)
          heading(date)
        }
      }
    } catch (e) {
      if (id !== current) return
      console.error(e)
      grid.replaceChildren()
      say(`Couldn't load games for ${short(date)}. `, retry())
      grid.dataset.state = "failed"
      return
    }
    if (id !== current) return
    neighbors(date, id)

    // the games not played yet, predicted. A failed read leaves the played
    // games standing
    const predictions = await predictionsOn(
      date,
      new Set(games.map(g => g.game_id)),
    ).catch(e => {
      console.error(e)
      return undefined
    })
    if (id !== current) return
    if (games.length === 0 && !predictions) {
      grid.replaceChildren()
      say(`Couldn't load predictions for ${short(date)}. `, retry())
      grid.dataset.state = "failed"
      return
    }

    if (games.length === 0 && predictions?.length === 0) {
      grid.replaceChildren()
      const [before, after] = await Promise.all([
        nearestGameDay(date, -1).catch(() => undefined),
        nearestGameDay(date, 1).catch(() => undefined),
      ])
      if (id !== current) return
      const links = [
        before && link(`← ${short(before)}`, before),
        after && link(`${short(after)} →`, after),
      ].filter((l): l is HTMLAnchorElement => Boolean(l))
      say(
        `No games on ${short(date)}. `,
        ...links.flatMap((l, i) => (i ? [" · ", l] : [l])),
      )
      grid.dataset.state = "empty"
      return
    }

    const blocks = games.map(g => gameBlock(g, base))
    // played and predicted together, in the NBA's order
    grid.replaceChildren(
      ...[
        ...games.map((g, i) => [g.game_id, blocks[i]] as const),
        ...(predictions ?? []).map(p => [p.game_id, predictionBlock(p)] as const),
      ]
        .sort((a, b) => a[0].localeCompare(b[0]))
        .map(([, b]) => b),
    )
    if (!predictions) say("Predictions couldn't load.")
    else if (predictions.length)
      say(
        `Predicted ${short(predictions[0].asOf)}, from the games before it. ` +
          "Chance to play is from each team's last 10 games.",
      )
    // ESPN's numbers and the predictions come apart from the NBA's, so they
    // never hold up the scores; a game ESPN hasn't published says so
    const [factors, logged] = await Promise.all([
      factorsFor(games).catch(e => {
        console.error(e)
        return new Map()
      }),
      loggedFor(games).catch(e => {
        console.error(e)
        return new Map()
      }),
    ])
    if (id !== current) return
    games.forEach((g, i) => {
      setFactors(blocks[i], g, factors.get(g.game_id))
      setLogged(blocks[i], logged.get(g.game_id))
    })
    grid.dataset.state = "done"
  }

  function heading(date: string) {
    day.textContent = long(date)
    input.value = date
    prev.hidden = next.hidden = true
  }

  // prev and next skip to the nearest days with games
  async function neighbors(date: string, id: number) {
    const [before, after] = await Promise.all([
      nearestGameDay(date, -1).catch(() => undefined),
      nearestGameDay(date, 1).catch(() => undefined),
    ])
    if (id !== current) return
    for (const [a, d] of [
      [prev, before],
      [next, after],
    ] as const) {
      a.hidden = !d
      if (d) a.href = href(d)
    }
  }

  function say(...parts: (Node | string)[]) {
    note.replaceChildren(...parts)
    note.hidden = false
  }

  function link(text: string, date: string) {
    return Object.assign(document.createElement("a"), {
      textContent: text,
      href: href(date),
    })
  }

  function retry() {
    const b = Object.assign(document.createElement("button"), {
      textContent: "Try again",
    })
    b.addEventListener("click", show)
    return b
  }

  function go(date: string) {
    history.pushState(null, "", href(date))
    show()
  }

  // date links change the page in place
  document.addEventListener("click", e => {
    const a = (e.target as Element).closest?.("a")
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return
    const d = valid(new URL(a.href, location.href).searchParams.get("date"))
    if (d && a.pathname === location.pathname) {
      e.preventDefault()
      go(d)
    }
  })
  input.addEventListener("change", () => {
    if (valid(input.value)) go(input.value)
  })
  addEventListener("popstate", show)
  show()
</script>
