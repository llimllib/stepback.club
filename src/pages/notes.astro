---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  })
---

<Base title="Notes">
  <h1>Notes</h1>
  <p class="lede">Charts with a sentence or two about why.</p>
  <ul class="index">
    {notes.map(n => (
      <li>
        <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt(n.data.date)}</time>
        <h2><a href={`${base}notes/${n.id}`}>{n.data.title}</a></h2>
        <p>{n.data.deck}</p>
      </li>
    ))}
  </ul>
</Base>
